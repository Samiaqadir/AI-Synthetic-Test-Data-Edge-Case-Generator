{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserEvent",
  "type": "object",
  "required": ["event_id", "user_id", "event_type", "timestamp", "session_duration"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the telemetry event"
    },
    "user_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Identifier of the actor user"
    },
    "event_type": {
      "type": "string",
      "enum": ["login", "page_view", "checkout", "logout", "error_triggered"],
      "description": "Categorical event type"
    },
    "ip_address": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$",
      "description": "IPv4 address"
    },
    "user_email": {
      "type": "string",
      "format": "email",
      "maxLength": 100,
      "description": "User email address"
    },
    "session_duration": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 86400.0,
      "description": "Session duration in seconds"
    },
    "device_platform": {
      "type": "string",
      "enum": ["ios", "android", "web", "desktop"]
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
